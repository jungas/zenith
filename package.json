{
  "name": "zenith",
  "version": "1.0.0",
  "description": "Zenith \u2014 an installable PWA for envelope budgeting with credit-card management wired into the budget, self-hosted against its own server.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && node tools/stamp-sw.ts",
    "start": "npm run build && node server/index.ts",
    "dev": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "npm run typecheck && node --test \"tests/**/*.test.ts\"",
    "test:only": "node --test \"tests/**/*.test.ts\"",
    "icons": "node tools/gen-icons.ts",
    "clean": "node -e \"for (const p of ['dist','dist-artifact','.artifact-build','sw.js']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "build:artifact": "node tools/build-artifact.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "pwa",
    "budget",
    "envelope-budgeting",
    "credit-cards",
    "self-hosted"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  }
}
